<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RDS Slow Query Analyzer</title>
    <!-- Using a CDN for Bootstrap for simplicity -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Link to our custom stylesheet -->
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
    <div class="container mt-5">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h2>RDS Slow Query Log Analyzer</h2>
            </div>
            <div class="card-body">
                <!-- This block displays an error if the app couldn't fetch RDS instances -->
                {% if error_message %}
                <div class="alert alert-danger" role="alert">
                    <strong>Error fetching RDS instances:</strong> {{ error_message }}
                    <br>Please check the application's AWS credentials and IAM permissions (rds:DescribeDBInstances).
                </div>
                {% endif %}

                <form id="analysis-form">
                    <div class="mb-3">
                        <label for="db-instances" class="form-label">Select DB Instance(s)</label>
                        <!-- This is the multi-select dropdown, populated by the Flask backend -->
                        <select multiple class="form-control" id="db-instances" required size="8">
                            <!-- Jinja2 loop populates the options -->
                            {% for instance in db_instances %}
                                <option value="{{ instance }}">{{ instance }}</option>
                            {% endfor %}
                        </select>
                        <div class="form-text">Hold Ctrl (or Cmd on Mac) to select multiple instances.</div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="start-date" class="form-label">Start Date</label>
                            <input type="date" class="form-control" id="start-date" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="end-date" class="form-label">End Date</label>
                            <input type="date" class="form-control" id="end-date" required>
                        </div>
                    </div>
                    <!-- The submit button is disabled if no instances could be loaded -->
                    <button type="submit" class="btn btn-primary w-100" id="submit-btn" {% if not db_instances %}disabled{% endif %}>
                        <span id="btn-text">Start Analysis</span>
                        <div class="spinner-border spinner-border-sm d-none" id="btn-spinner" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </button>
                </form>
            </div>
        </div>

        <!-- THIS IS THE STATUS CONTAINER THAT WAS MISSING -->
        <!-- It's hidden by default with the 'd-none' class -->
        <div id="status-container" class="mt-4 d-none">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Analysis Progress</h5>
                    <div class="progress mb-2" role="progressbar" aria-label="Animated striped example" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
                    </div>
                    <!-- The JavaScript will write status updates here. ID is 'status-message' -->
                    <p id="status-message" class="text-muted mb-0">Starting...</p>
                </div>
            </div>
        </div>

        <!-- This container holds the final report links. Hidden by default. -->
        <div id="results-container" class="mt-4 d-none">
            <div class="card">
                <div class="card-header">
                    Analysis Complete!
                </div>
                <div class="card-body">
                    <p>Reports are available below:</p>
                    <!-- The JavaScript will insert report links into this list -->
                    <ul class="list-group" id="results-list">
                        <!-- Example: <li class="list-group-item"><a href="#">Report 1</a></li> -->
                    </ul>
                </div>
            </div>
        </div>

    </div>

    <!-- Link to our JavaScript file at the end of the body -->
    <script src="{{ url_for('static', filename='script.js') }}"></script>
</body>
</html>
